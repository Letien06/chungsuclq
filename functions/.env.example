# Environment variables for Cloud Functions
# Copy this to .env and fill in your values

# QVTool API (keep the key secret; do not commit it)
QVTOOL_API_URL=https://aov.qvtool.com/api/v1
QVTOOL_API_KEY=replace_with_qvtool_api_key
QVTOOL_POLL_INTERVAL=5000
QVTOOL_RESULT_TIMEOUT=540000

# Admin password for the admin panel
ADMIN_PASSWORD=changeme123
