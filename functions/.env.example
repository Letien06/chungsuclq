# Environment variables for Cloud Functions
# Copy this to .env and fill in your values

# SieuCap5s credentials
SIEUCAP5S_USERNAME=your_sieucap5s_username
SIEUCAP5S_PASSWORD=your_sieucap5s_password

# Admin password for the admin panel
ADMIN_PASSWORD=changeme123

# Tool URL on sieucap5s (update when Chung Suc tool opens)
SIEUCAP5S_TOOL_URL=https://sieucap5s.com/services/tool/nhap-ma-qua-tang-sk-the-lsr.aspx
